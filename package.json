{
	"name": "dotdigital-for-wordpress",
	"version": "1.0.0",
	"description": "Dotdigital for WordPress",
	"author": "Dotdigital",
	"license": "MIT",
	"homepage": "#",
	"main": "build/index.js",
	"scripts": {
		"build": "node tools/build.js",
		"start": "node tools/build.js --watch",
		"lint:js:blocks": "eslint blocks/",
		"lint:js:blocks:fix": "eslint blocks/ --fix",
		"lint:js:admin": "eslint admin/js/",
		"lint:js:admin:fix": "eslint admin/js/ --fix",
		"lint:js:public": "eslint public/js/",
		"lint:js:public:fix": "eslint public/js/ --fix",
		"lint:js": "npm run lint:js:blocks && npm run lint:js:admin && npm run lint:js:public",
		"lint:js:fix": "npm run lint:js:blocks:fix && npm run lint:js:admin:fix && npm run lint:js:public:fix"
	},
	"dependencies": {
		"@wordpress/api-fetch": "^7.53.0",
		"classnames": "^2.5.1"
	},
	"peerDependencies": {
		"@wordpress/block-editor": "*",
		"@wordpress/blocks": "*",
		"@wordpress/components": "*",
		"@wordpress/element": "*",
		"@wordpress/url": "*"
	},
	"devDependencies": {
		"@wordpress/eslint-plugin": "^25.9.0",
		"esbuild": "^0.25.0",
		"eslint": "^9.0.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"rtlcss": "^4.3.0",
		"sass": "^1.80.0"
	}
}
